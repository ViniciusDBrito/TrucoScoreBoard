<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Marcador de Truco"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvLabelA"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Time A"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/tvPontosA"
        app:layout_constraintEnd_toStartOf="@id/tvLabelB"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tvPontosA"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="4dp"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="56sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/btnPontoA"
        app:layout_constraintEnd_toEndOf="@id/tvLabelA"
        app:layout_constraintStart_toStartOf="@id/tvLabelA"
        app:layout_constraintTop_toBottomOf="@id/tvLabelA" />

    <Button
        android:id="@+id/btnPontoA"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="#FFFF8F00"
        android:text="+1"
        android:textColor="#000000"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/tvMaoDeOnze"
        app:layout_constraintEnd_toEndOf="@id/tvLabelA"
        app:layout_constraintStart_toStartOf="@id/tvLabelA"
        app:layout_constraintTop_toBottomOf="@id/tvPontosA"
        app:layout_constraintWidth_percent="0.4" />

    <TextView
        android:id="@+id/tvLabelB"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Time B"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/tvPontosB"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tvLabelA"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tvPontosB"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="4dp"
        android:text="0"
        android:textColor="#FFFFFF"
        android:textSize="56sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/btnPontoB"
        app:layout_constraintEnd_toEndOf="@id/tvLabelB"
        app:layout_constraintStart_toStartOf="@id/tvLabelB"
        app:layout_constraintTop_toBottomOf="@id/tvLabelB" />

    <Button
        android:id="@+id/btnPontoB"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="#FFFF8F00"
        android:text="+1"
        android:textColor="#000000"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/tvMaoDeOnze"
        app:layout_constraintEnd_toEndOf="@id/tvLabelB"
        app:layout_constraintStart_toStartOf="@id/tvLabelB"
        app:layout_constraintTop_toBottomOf="@id/tvPontosB"
        app:layout_constraintWidth_percent="0.4" />

    <TextView
        android:id="@+id/tvMaoDeOnze"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        android:text="MÃO DE ONZE!"
        android:textColor="#FFFF8F00"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/btnTruco"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnTruco"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="#FFFF8F00"
        android:text="TRUCO! (+3)"
        android:textColor="#000000"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/btnReiniciar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/btnReiniciar"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Reiniciar"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="#FFFFFF" />

</androidx.constraintlayout.widget.ConstraintLayout>